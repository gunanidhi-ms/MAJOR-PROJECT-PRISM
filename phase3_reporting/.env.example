# ============================================================
# .env.example  –  PRISM Phase 3 Configuration
# ============================================================
# Copy this file to .env and set values for your environment.
#
#   cp .env.example .env
#
# All variables are optional – defaults shown below will be
# used if the corresponding variable is absent from .env.
# ============================================================

# ── Ollama / LLM ────────────────────────────────────────────
# Base URL of the running Ollama server.
OLLAMA_HOST=http://localhost:11434

# Model to use for grammar refinement.
# Must be pulled first: ollama pull llama3.2
OLLAMA_MODEL=llama3.2

# Sampling temperature (keep low for reproducibility).
OLLAMA_TEMPERATURE=0.2

# HTTP timeout in seconds for Ollama API calls.
OLLAMA_TIMEOUT=120

# ------------------------------------------------------------------ #
# Logging settings
# ------------------------------------------------------------------ #
LOG_FILE=logs/phase3.log
LOG_LEVEL=INFO
# ── FastAPI ──────────────────────────────────────────────────
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# Set to true to enable auto-reload and verbose logging.
FASTAPI_DEBUG=false

# ── Storage ──────────────────────────────────────────────────
# Directory where report JSON files are saved.
REPORTS_DIR=reports

# ── Behaviour ────────────────────────────────────────────────
# Set to true to bypass Ollama entirely (template text used directly).
# Useful for offline development and CI pipelines.
SKIP_LLM=false

# ── Institution metadata (optional) ─────────────────────────
INSTITUTION_NAME=PRISM Radiology Centre
# RADIOLOGIST_NAME=Dr. Jane Smith
