# ============================================================
# .env.example  –  PRISM Phase 3 Configuration
# ============================================================
# Copy this file to .env and set values for your environment.
#
#   cp .env.example .env
#
# All variables are optional – defaults shown below will be
# used if the corresponding variable is absent from .env.
# ============================================================

# ── Ollama / LLM ────────────────────────────────────────────
# Base URL of the running Ollama server.
OLLAMA_HOST=http://127.0.0.1:11434

# Model to use for grammar refinement. The setup helper pulls this exact value.
# Pick a model your laptop can run; llama3.2:3b is the portable default.
OLLAMA_MODEL=llama3.2:3b

# Sampling temperature (keep low for reproducibility).
OLLAMA_TEMPERATURE=0.2

# HTTP timeout in seconds for Ollama API calls.
OLLAMA_TIMEOUT=120

# Setup behaviour. Set OLLAMA_AUTO_PULL=false when a remote administrator
# manages models, or when model downloads must be performed manually.
OLLAMA_AUTO_PULL=true
OLLAMA_START_TIMEOUT=30

# Normally simply "ollama". Set a full path only if your installation is not
# on PATH, for example: OLLAMA_COMMAND=C:\\Tools\\Ollama\\ollama.exe
OLLAMA_COMMAND=ollama

# ------------------------------------------------------------------ #
# Logging settings
# ------------------------------------------------------------------ #
LOG_FILE=logs/phase3.log
LOG_LEVEL=INFO
# ── FastAPI ──────────────────────────────────────────────────
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# Set to true to enable auto-reload and verbose logging.
FASTAPI_DEBUG=false

# ── Storage ──────────────────────────────────────────────────
# Directory where report JSON files are saved.
REPORTS_DIR=reports

# ── Behaviour ────────────────────────────────────────────────
# Set to true to bypass Ollama entirely (template text used directly).
# Useful for offline development and CI pipelines.
SKIP_LLM=false

# ── Institution metadata (optional) ─────────────────────────
INSTITUTION_NAME=PRISM Radiology Centre
# RADIOLOGIST_NAME=Dr. Jane Smith
